<!--
  Optional: surface AkeylessIntegrationLog (System.Diagnostics.Trace) to Windows listeners.
  This does not log secret values when using the provided sample code.
-->
<configuration>
  <system.diagnostics>
    <trace autoflush="true" indentsize="0">
      <listeners>
        <add name="eventLogListener"
             type="System.Diagnostics.EventLogTraceListener, System, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089"
             initializeData="Application" />
      </listeners>
    </trace>
  </system.diagnostics>
</configuration>
